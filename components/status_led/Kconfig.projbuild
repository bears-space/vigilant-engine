menu "Vigilant Engine Configuration: LEDs"
    config VE_ENABLE_STATUS_LED
        bool "Enable Status LED"
        default y
        help
            Enable this option to use the status LED functionality in Vigilant Engine.
            The status LED provides visual feedback on the system's status and operations, and can optionally be used for visual output.

    choice VE_LED_TYPE
        prompt "LED Type"
        default VE_LED_TYPE_WS2812B
        depends on VE_ENABLE_STATUS_LED
        help
            Select the type of LED functionality to enable in Vigilant Engine.

        config VE_LED_TYPE_WS2812B
            bool "WS2812B LED"

    endchoice

    config VE_STATUS_WS2812B_PIN
        int "WS2812B Data Pin"
        default 8
        depends on VE_LED_TYPE_WS2812B

    config VE_LOG_INFO_PULSE_MS
        int "Log Info Pulse Duration (ms)"
        default 35
        depends on VE_ENABLE_STATUS_LED
        help
            Set the duration of the pulse for log info events in milliseconds.

    config VE_LOG_WARN_PULSE_MS
        int "Log Warning Pulse Duration (ms)"
        default 80
        depends on VE_ENABLE_STATUS_LED
        help
            Set the duration of the pulse for log warning events in milliseconds.

    config VE_LOG_ERROR_PULSE_MS
        int "Log Error Pulse Duration (ms)"
        default 200
        depends on VE_ENABLE_STATUS_LED
        help
            Set the duration of the pulse for log error events in milliseconds.

endmenu
